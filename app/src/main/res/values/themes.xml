<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App_ariz" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ariz_brand</item>
        <item name="android:windowBackground">@color/ariz_canvas</item>
    </style>

    <!-- Tema de arranque: splash del sistema blanco con el logo (igual que el inicio de ArizSplash); luego pasa a Theme.App_ariz. -->
    <style name="Theme.App_ariz.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.App_ariz</item>
    </style>
</resources>
